generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  ADMIN
  MANAGER
  CLAIMS_REPRESENTATIVE
  REVIEWER
  VIEWER
}

enum ClaimStatus {
  OPEN
  AWAITING_EVIDENCE
  UNDER_REVIEW
  MEDICAL_REVIEW
  DECISION_DRAFTING
  READY_FOR_DETERMINATION
  CLOSED
}

enum ClaimEventType {
  CLAIM_CREATED
  CLAIM_UPDATED
  EMAIL_RECEIVED
  DOCUMENT_UPLOADED
  DOCUMENT_MOVED_OUT
  DOCUMENT_MOVED_IN
  FILE_NOTE_CREATED
  PHONE_CALL
  TASK_CREATED
  TASK_COMPLETED
  MEDICAL_EVIDENCE_RECEIVED
  EMPLOYER_RESPONSE_RECEIVED
  WORKER_RESPONSE_RECEIVED
  NATURAL_JUSTICE_ISSUED
  DECISION_DRAFTED
  DECISION_FINALISED
  IMPORT_COMPLETED
  GENERAL
}

enum DocumentSource {
  MANUAL_UPLOAD
  INCOMING_EMAIL
  HISTORICAL_IMPORT
  API
  SYSTEM
}

enum DocumentCategory {
  MEDICAL
  EMPLOYMENT
  WORKER
  EMPLOYER
  WITNESS
  PAYROLL
  COMMUNICATION
  PHOTO
  VIDEO
  OTHER
}

enum CommunicationDirection {
  INCOMING
  OUTGOING
}

enum CommunicationChannel {
  EMAIL
  PHONE
  SMS
  PORTAL
  INTERNAL_NOTE
}

enum CommunicationStatus {
  RECEIVED
  PROCESSING
  FILED
  NEEDS_REVIEW
  FAILED
  QUARANTINED
}

enum ClaimMatchMethod {
  CLAIM_NUMBER_SUBJECT
  CLAIM_NUMBER_BODY
  THREAD
  MANUAL
  UNMATCHED
}

model Organisation {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  memberships    Membership[]
  claims         Claim[]
  communications Communication[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  memberships   Membership[]
  ownedClaims   Claim[]      @relation("ClaimOwner")
  createdEvents ClaimEvent[] @relation("EventCreator")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Membership {
  id             String         @id @default(cuid())
  organisationId String
  userId         String
  role           MembershipRole @default(CLAIMS_REPRESENTATIVE)
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organisationId, userId])
  @@index([userId])
}

model Claim {
  id                    String          @id @default(cuid())
  organisationId        String
  ownerId                String?
  claimNumber            String
  claimantName           String
  injury                 String
  status                 ClaimStatus     @default(OPEN)
  nextAction             String
  determinationReadiness Int             @default(0)
  organisation           Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  owner                  User?           @relation("ClaimOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  events                 ClaimEvent[]
  documents              Document[]
  communications         Communication[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@unique([organisationId, claimNumber])
  @@index([organisationId, status])
  @@index([ownerId])
}

model ClaimEvent {
  id             String          @id @default(cuid())
  claimId        String
  createdById    String?
  type           ClaimEventType  @default(GENERAL)
  title          String
  description    String?
  occurredAt     DateTime        @default(now())
  metadata       Json?
  claim          Claim           @relation(fields: [claimId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  documents      Document[]
  communications Communication[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([claimId, occurredAt])
  @@index([claimId, type])
  @@index([createdById])
}

model Communication {
  id                String                 @id @default(cuid())
  organisationId    String
  claimId           String?
  eventId           String?
  direction         CommunicationDirection @default(INCOMING)
  channel           CommunicationChannel   @default(EMAIL)
  status            CommunicationStatus    @default(RECEIVED)
  matchMethod       ClaimMatchMethod        @default(UNMATCHED)
  matchConfidence   Int                     @default(0)
  sender            String
  recipients        Json
  ccRecipients      Json?
  subject           String
  bodyText          String?
  bodyHtml          String?
  internetMessageId String?                 @unique
  threadId          String?
  rawStorageKey     String?
  receivedAt        DateTime
  organisation      Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  claim             Claim?                  @relation(fields: [claimId], references: [id], onDelete: SetNull)
  event             ClaimEvent?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  documents         Document[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([organisationId, status, receivedAt])
  @@index([claimId, receivedAt])
  @@index([threadId])
}

model Document {
  id              String           @id @default(cuid())
  claimId         String
  eventId         String?
  communicationId String?
  originalName    String
  storageKey      String           @unique
  mimeType        String
  sizeBytes       Int
  sha256          String
  source          DocumentSource   @default(MANUAL_UPLOAD)
  category        DocumentCategory @default(OTHER)
  claim           Claim            @relation(fields: [claimId], references: [id], onDelete: Cascade)
  event           ClaimEvent?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  communication   Communication?   @relation(fields: [communicationId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([claimId, sha256])
  @@index([claimId, createdAt])
  @@index([eventId])
  @@index([communicationId])
  @@index([claimId, category])
}
